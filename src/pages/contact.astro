---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact BamaClean | Free Quote | (256) 324-0492"
  description="Get a free quote from BamaClean. Call (256) 324-0492 or fill out our form for carpet, tile, water damage & mold services across North Alabama. 24/7 emergency line."
  canonical="/contact/"
>

  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#0F1B2D 0%,#1A2A42 100%);color:#fff;padding:72px 24px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#22C55E;margin-bottom:12px;">Reach Out</p>
      <h1 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:800;margin-bottom:16px;">Contact Us</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,.8);line-height:1.7;">Ready for a cleaner home or dealing with an emergency? We're here to help. Call us anytime or fill out the form below.</p>
    </div>
  </section>

  <!-- Contact Cards + Form -->
  <section style="padding:80px 24px;background:#F1F5F9;">
    <div style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px;align-items:start;">

      <!-- Contact Info -->
      <div>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.5rem;font-weight:800;color:#0F1B2D;margin-bottom:32px;">Get in Touch</h2>

        <!-- Emergency -->
        <div style="background:#FEF2F2;border:1px solid #FECACA;border-radius:16px;padding:24px;margin-bottom:20px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
            <span style="font-size:1.5rem;">🚨</span>
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;color:#DC2626;">24/7 Emergency Service</h3>
          </div>
          <p style="font-size:.9375rem;color:#475569;margin-bottom:12px;">Water damage or flooding? Don't wait — call us immediately.</p>
          <a href="tel:+12563240492" style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.375rem;font-weight:800;color:#DC2626;">(256) 324-0492</a>
        </div>

        <!-- Phone -->
        <div style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:24px;margin-bottom:20px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
            <span style="font-size:1.5rem;">📞</span>
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;color:#0F1B2D;">Phone</h3>
          </div>
          <a href="tel:+12563240492" style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:700;color:#1B7A3D;">(256) 324-0492</a>
          <p style="font-size:.875rem;color:#94A3B8;margin-top:4px;">Mon–Sun, 7am–10pm (Emergency: 24/7)</p>
        </div>

        <!-- Address -->
        <div style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:24px;margin-bottom:20px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
            <span style="font-size:1.5rem;">📍</span>
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;color:#0F1B2D;">Address</h3>
          </div>
          <p style="font-size:.9375rem;color:#475569;">205 S Seminary St<br/>Florence, AL 35630</p>
        </div>

        <!-- Social -->
        <div style="background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:24px;">
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
            <span style="font-size:1.5rem;">🌐</span>
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;color:#0F1B2D;">Follow Us</h3>
          </div>
          <div style="display:flex;gap:12px;">
            <a href="https://www.facebook.com/people/BamaCleancom-Cleaning-Sanitation-Services/100063969132518/" target="_blank" rel="noopener" style="background:#1877F2;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:8px;">Facebook</a>
            <a href="https://www.instagram.com/bamacleanteam/" target="_blank" rel="noopener" style="background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:8px;">Instagram</a>
          </div>
        </div>
      </div>

      <!-- Quote Form -->
      <div style="background:#fff;border-radius:20px;padding:40px;box-shadow:0 4px 24px rgba(0,0,0,.08);">
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.5rem;font-weight:800;color:#0F1B2D;margin-bottom:8px;">Request a Free Quote</h2>
        <p style="color:#475569;font-size:.9375rem;margin-bottom:32px;">Fill out the form and we'll get back to you within a few hours.</p>

        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" style="display:flex;flex-direction:column;gap:20px;">
          <input type="hidden" name="form-name" value="contact" />
          <p style="display:none;"><input name="bot-field" /></p>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div>
              <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">First Name *</label>
              <input required type="text" name="first_name" placeholder="John" style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;transition:border-color .2s;" />
            </div>
            <div>
              <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">Last Name *</label>
              <input required type="text" name="last_name" placeholder="Smith" style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;" />
            </div>
          </div>

          <div>
            <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">Phone Number *</label>
            <input required type="tel" name="phone" placeholder="(256) 555-0100" style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;" />
          </div>

          <div>
            <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">Email Address</label>
            <input type="email" name="email" placeholder="john@example.com" style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;" />
          </div>

          <div>
            <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">City / Location *</label>
            <input required type="text" name="city" placeholder="Madison, AL" style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;" />
          </div>

          <div>
            <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">Service Needed *</label>
            <select required name="service" style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;background:#fff;appearance:none;">
              <option value="">Select a service...</option>
              <option value="carpet">Carpet Cleaning</option>
              <option value="tile">Tile & Grout Cleaning</option>
              <option value="upholstery">Upholstery Cleaning</option>
              <option value="water">Water Damage Restoration</option>
              <option value="mold">Mold Inspection / Removal</option>
              <option value="fire">Fire & Smoke Damage</option>
              <option value="other">Other / Not Sure</option>
            </select>
          </div>

          <div>
            <label style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#334155;margin-bottom:6px;">Tell Us More</label>
            <textarea name="message" rows="4" placeholder="Describe your situation, square footage, urgency, or any details that would help us provide an accurate quote..." style="width:100%;padding:12px 16px;border:1px solid #E2E8F0;border-radius:10px;font-size:.9375rem;font-family:'DM Sans',sans-serif;outline:none;resize:vertical;"></textarea>
          </div>

          <button type="submit" style="background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:1rem;padding:16px 32px;border-radius:100px;border:none;cursor:pointer;transition:background .2s;width:100%;">
            Send My Quote Request
          </button>

          <p style="font-size:.8125rem;color:#94A3B8;text-align:center;">We typically respond within 2–4 hours during business hours.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:80px 24px;background:#fff;">
    <div style="max-width:800px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:56px;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Common Questions</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:#0F1B2D;">Frequently Asked Questions</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;">
        {[
          { q: 'How quickly can you come out?', a: 'For standard cleaning services, we can usually schedule within 1–3 business days. For water damage emergencies, we respond 24/7 and aim to be on site within 1–2 hours of your call.' },
          { q: 'How long does carpet cleaning take to dry?', a: 'Most carpets dry in 6–10 hours with hot-water extraction. We use high-powered extraction equipment that removes most of the moisture during the cleaning process.' },
          { q: 'Are your cleaning products safe for kids and pets?', a: 'Yes. We use eco-friendly, family-safe cleaning solutions throughout our process — safe for children and pets.' },
          { q: 'Do you offer free estimates?', a: 'Yes! Call us at (256) 324-0492 or fill out the form above. We provide free, no-obligation quotes for all services.' },
          { q: 'Do you work with insurance companies?', a: 'Yes. For water damage, fire damage, and mold remediation, we can work directly with your insurance company and provide the documentation needed for your claim.' },
        ].map(item => (
          <div style="background:#F8FAFB;border:1px solid #E2E8F0;border-radius:12px;padding:24px;">
            <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;color:#0F1B2D;margin-bottom:8px;">{item.q}</h3>
            <p style="font-size:.9375rem;color:#475569;line-height:1.6;">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

---
// SocialProof.astro
// Sections: testimonials, review badges, before/after gallery,
//           service area map, trust badges, response time stats
---

<!-- ================================================================
     1. RESPONSE TIME STATS
     ================================================================ -->
<section style="background:#0F1B2D;padding:56px 24px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#22C55E;margin-bottom:10px;">Emergency Response</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#fff;">Numbers That Matter When It's Your Home</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:2px;background:rgba(255,255,255,.06);border-radius:16px;overflow:hidden;">
      {[
        { stat: '40+',      label: 'Years Serving\nNorth Alabama',  color: '#22C55E' },
        { stat: '10 min',   label: 'Fastest Response\n(Florence & Madison)', color: '#22C55E' },
        { stat: '24/7',     label: 'Emergency\nDispatch',           color: '#22C55E' },
        { stat: '100%',     label: 'Satisfaction\nGuarantee',       color: '#22C55E' },
        { stat: '5,000+',   label: 'Jobs Completed\nin North AL',   color: '#22C55E' },
        { stat: '$0',       label: 'Hidden Fees —\nEver',           color: '#22C55E' },
      ].map(s => (
        <div style="background:#0F1B2D;padding:32px 20px;text-align:center;">
          <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:2rem;font-weight:800;color:${s.color};margin-bottom:8px;`}>{s.stat}</p>
          <p style="font-size:.8125rem;color:rgba(255,255,255,.6);line-height:1.5;white-space:pre-line;">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================================================================
     2. TRUST BADGES
     ================================================================ -->
<section style="background:#fff;padding:56px 24px;border-bottom:1px solid #E2E8F0;">
  <div style="max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:40px;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Credentials & Certifications</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;">Why Certified Matters for Your Home</h2>
      <p style="color:#475569;margin-top:12px;max-width:600px;margin-left:auto;margin-right:auto;">Anyone can rent a machine. Only IICRC-certified firms have the training to handle water damage, mold, and restoration without making it worse.</p>
    </div>

    <!-- Badge row -->
    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:40px;margin-bottom:48px;">
      <div style="text-align:center;">
        <img src="/images/iicrc.jpg" alt="IICRC Certified Firm" width="110" height="110" loading="lazy" style="width:110px;height:110px;object-fit:contain;" />
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:700;color:#334155;margin-top:8px;">IICRC Certified</p>
      </div>
      <div style="text-align:center;">
        <img src="/images/bbb.jpg" alt="BBB A+ Accredited Business" width="90" height="110" loading="lazy" style="width:90px;height:110px;object-fit:contain;" />
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:700;color:#334155;margin-top:8px;">BBB A+ Rated</p>
      </div>
      <div style="text-align:center;">
        <img src="/images/img-badges.webp" alt="CRMI and CCMI Mold Inspector Certified" width="140" height="110" loading="lazy" style="width:140px;height:110px;object-fit:contain;" />
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:700;color:#334155;margin-top:8px;">CRMI · CCMI Certified</p>
      </div>
      <div style="text-align:center;">
        <img src="/images/sam-gov.jpg" alt="SAM.gov Registered Federal Contractor" width="110" height="60" loading="lazy" style="width:110px;height:60px;object-fit:contain;" />
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:700;color:#334155;margin-top:8px;">SAM.gov Active</p>
      </div>
    </div>

    <!-- Credential detail cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;">
      {[
        { icon:'🏅', title:'IICRC WRT', sub:'Water Damage Restoration Technician', desc:'The industry gold standard for water damage response. Ensures correct drying protocols that prevent secondary mold growth.' },
        { icon:'🏅', title:'IICRC AMRT', sub:'Applied Microbial Remediation Technician', desc:'Certified mold remediation per IICRC S520 protocol — the standard insurance companies and inspectors recognize.' },
        { icon:'🏅', title:'EPA LEAD', sub:'Lead-Safe Certified Renovator', desc:'Required for work on homes built before 1978. Protects your family during remediation in older North Alabama homes.' },
        { icon:'🏅', title:'CRMI / CCMI', sub:'Certified Mold Inspector (Residential & Commercial)', desc:'Professional Mold Inspection Institute certifications covering both residential and commercial mold assessment.' },
        { icon:'🛡️', title:'Licensed, Insured & Bonded', sub:'State of Alabama', desc:'Full liability coverage and bonding on every job. You are protected if anything goes wrong — period.' },
        { icon:'🌿', title:'Green Seal Products', sub:'EPA-Registered, Environmentally Safe', desc:'We use Green Seal certified cleaning products — effective, safe for children and pets, and better for the environment.' },
      ].map(c => (
        <div style="background:#F8FAFB;border:1px solid #E2E8F0;border-radius:14px;padding:22px;">
          <p style="font-size:1.5rem;margin-bottom:10px;">{c.icon}</p>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:.9375rem;color:#0F1B2D;margin-bottom:2px;">{c.title}</p>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:600;color:#1B7A3D;margin-bottom:8px;">{c.sub}</p>
          <p style="font-size:.875rem;color:#475569;line-height:1.6;">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================================================================
     3. BEFORE / AFTER GALLERY
     ================================================================ -->
<section style="background:#F1F5F9;padding:72px 24px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Real Results</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;margin-bottom:12px;">Before & After — North Alabama Homes</h2>
      <p style="color:#475569;max-width:560px;margin:0 auto;">Every photo is from an actual BamaClean job. No stock images, no staging — just the results our customers see when we're done.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(560px,1fr));gap:28px;" class="ba-grid">

      <!-- Carpet -->
      <div style="background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08);">
        <div style="position:relative;">
          <img src="/images/carpet-1-BA.webp" alt="Carpet cleaning before and after — North Alabama home" width="760" height="400" loading="lazy" style="width:100%;height:260px;object-fit:cover;display:block;" />
          <div style="position:absolute;top:12px;left:12px;background:#0F1B2D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.7rem;font-weight:700;padding:4px 12px;border-radius:100px;letter-spacing:.06em;text-transform:uppercase;">Carpet Cleaning</div>
        </div>
        <div style="padding:20px 24px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#0F1B2D;font-size:1rem;margin-bottom:4px;">Living Room — Madison, AL</p>
          <p style="font-size:.875rem;color:#475569;line-height:1.6;">Heavy pet staining and ground-in soil throughout. Hot-water extraction restored color and removed embedded allergens. Dried in under 4 hours.</p>
        </div>
      </div>

      <!-- Tile -->
      <div style="background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08);">
        <div style="position:relative;">
          <img src="/images/Tile-1-BA.webp" alt="Tile and grout cleaning before and after" width="760" height="400" loading="lazy" style="width:100%;height:260px;object-fit:cover;display:block;" />
          <div style="position:absolute;top:12px;left:12px;background:#0F1B2D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.7rem;font-weight:700;padding:4px 12px;border-radius:100px;letter-spacing:.06em;text-transform:uppercase;">Tile & Grout</div>
        </div>
        <div style="padding:20px 24px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#0F1B2D;font-size:1rem;margin-bottom:4px;">Kitchen Floor — Huntsville, AL</p>
          <p style="font-size:.875rem;color:#475569;line-height:1.6;">Years of grease and soil embedded in grout lines. High-pressure steam extraction plus grout sealing — looks brand new, sealer protects for 3–5 years.</p>
        </div>
      </div>

      <!-- Upholstery -->
      <div style="background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08);">
        <div style="position:relative;">
          <img src="/images/sofa-1-BA.webp" alt="Sofa upholstery cleaning before and after" width="760" height="400" loading="lazy" style="width:100%;height:260px;object-fit:cover;display:block;" />
          <div style="position:absolute;top:12px;left:12px;background:#0F1B2D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.7rem;font-weight:700;padding:4px 12px;border-radius:100px;letter-spacing:.06em;text-transform:uppercase;">Upholstery</div>
        </div>
        <div style="padding:20px 24px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#0F1B2D;font-size:1rem;margin-bottom:4px;">Sectional Sofa — Florence, AL</p>
          <p style="font-size:.875rem;color:#475569;line-height:1.6;">Pet staining and accumulated body soil on a fabric sectional. Fabric-tested chemistry, low-moisture extraction — no shrinkage, no color bleed, no odor.</p>
        </div>
      </div>

      <!-- Water damage -->
      <div style="background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.08);">
        <div style="position:relative;">
          <img src="/images/flood-1-BA.webp" alt="Water damage restoration before and after" width="760" height="400" loading="lazy" style="width:100%;height:260px;object-fit:cover;display:block;" />
          <div style="position:absolute;top:12px;left:12px;background:#C0392B;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.7rem;font-weight:700;padding:4px 12px;border-radius:100px;letter-spacing:.06em;text-transform:uppercase;">🚨 Water Damage</div>
        </div>
        <div style="padding:20px 24px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#0F1B2D;font-size:1rem;margin-bottom:4px;">Basement Flood — Decatur, AL</p>
          <p style="font-size:.875rem;color:#475569;line-height:1.6;">Pipe burst flooded finished basement. Emergency dispatch within the hour — extraction, structural drying, remediation completed in 4 days. Total loss avoided.</p>
        </div>
      </div>

    </div>

    <div style="text-align:center;margin-top:36px;">
      <a href="#quote" style="display:inline-block;background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:14px 36px;border-radius:100px;font-size:1rem;">Get Results Like These →</a>
    </div>
  </div>
</section>

<!-- ================================================================
     4. CUSTOMER TESTIMONIALS
     ================================================================ -->
<section style="background:#fff;padding:72px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">What North Alabama Says</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;">Real Reviews From Real Customers</h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:24px;margin-bottom:48px;">
      {[
        {
          name: 'Jennifer M.',
          city: 'Madison, AL',
          service: 'Carpet Cleaning',
          stars: 5,
          text: 'BamaClean has been cleaning our carpets for over 10 years. AJ and his crew are the only ones I trust in my home. They quote a price and that\'s what I pay — no upsells, no surprises. My carpets look brand new every single time.',
        },
        {
          name: 'Robert T.',
          city: 'Huntsville, AL',
          service: 'Water Damage',
          stars: 5,
          text: 'Pipe burst at 2am. BamaClean was at my house by 3:15. I\'ve never been so relieved to see a truck in my driveway. They saved my hardwood floors and kept the mold from getting started. Worth every penny and then some.',
        },
        {
          name: 'Susan K.',
          city: 'Florence, AL',
          service: 'Tile & Grout',
          stars: 5,
          text: 'I had tried everything on my kitchen tile — nothing worked. BamaClean came out and in two hours my floor looked like the day it was installed. I actually cried. I had no idea tile could look like that again.',
        },
        {
          name: 'Marcus D.',
          city: 'Athens, AL',
          service: 'Radon Testing',
          stars: 5,
          text: 'We were buying a home and wanted radon tested. BamaClean came out fast, gave us a clear written report, and walked us through what the numbers meant. The other inspector we called never called back. These guys are professionals.',
        },
        {
          name: 'Patricia W.',
          city: 'Decatur, AL',
          service: 'Mold Remediation',
          stars: 5,
          text: 'Found mold in our crawlspace during a home inspection. BamaClean came out, showed us exactly what they found, explained every step of remediation, and followed up after. No guessing, no gouging. Just honest work.',
        },
        {
          name: 'David H.',
          city: 'Muscle Shoals, AL',
          service: 'Upholstery Cleaning',
          stars: 5,
          text: 'Had a sectional that our dog had basically claimed as his own. Thought we\'d have to replace it. BamaClean made it look — and smell — brand new. My wife couldn\'t believe it. We\'ve already booked them for the carpets.',
        },
      ].map(r => (
        <div style="background:#F8FAFB;border:1px solid #E2E8F0;border-radius:16px;padding:28px;">
          <div style="display:flex;gap:2px;margin-bottom:12px;">
            {Array.from({length: r.stars}).map(() => <span style="color:#F59E0B;font-size:1rem;">★</span>)}
          </div>
          <p style="font-size:.9375rem;color:#334155;line-height:1.7;margin-bottom:20px;">"{r.text}"</p>
          <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
            <div>
              <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#0F1B2D;font-size:.9375rem;">{r.name}</p>
              <p style="font-size:.8125rem;color:#94A3B8;">{r.city}</p>
            </div>
            <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:600;padding:4px 12px;border-radius:100px;">{r.service}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Review platform badges -->
    <div style="border-top:1px solid #E2E8F0;padding-top:36px;">
      <p style="text-align:center;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:#94A3B8;margin-bottom:24px;">Find Us On</p>
      <div style="display:flex;justify-content:center;flex-wrap:wrap;gap:20px;">
        {[
          { name: 'Google', rating: '4.9', reviews: '200+', color: '#4285F4', star: '★' },
          { name: 'Facebook', rating: '4.8', reviews: '150+', color: '#1877F2', star: '★' },
          { name: 'BBB', rating: 'A+', reviews: 'Accredited', color: '#003F87', star: '✓' },
          { name: 'Nextdoor', rating: '4.9', reviews: 'Neighborhood Fav', color: '#00B246', star: '★' },
        ].map(p => (
          <div style={`border:2px solid ${p.color}22;border-radius:14px;padding:18px 28px;text-align:center;min-width:140px;`}>
            <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:1.5rem;color:${p.color};`}>{p.star} {p.rating}</p>
            <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#0F1B2D;font-size:.875rem;margin-top:2px;">{p.name}</p>
            <p style="font-size:.75rem;color:#94A3B8;margin-top:2px;">{p.reviews} reviews</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ================================================================
     5. SERVICE AREA MAP — TWO LOCATIONS
     ================================================================ -->
<section style="background:#0F1B2D;padding:72px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#22C55E;margin-bottom:10px;">Where We Work</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#fff;margin-bottom:12px;">Two Locations. All of North Alabama Covered.</h2>
      <p style="color:rgba(255,255,255,.7);max-width:640px;margin:0 auto;">Florence HQ anchors the Shoals. Our Madison location puts us minutes from Huntsville, Madison City, and the Tennessee Valley corridor.</p>
    </div>

    <!-- ── LOCATION 1: Florence HQ ── -->
    <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:36px;margin-bottom:32px;">
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:28px;">
        <span style="background:#22C55E;color:#0F1B2D;font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:800;padding:4px 14px;border-radius:100px;text-transform:uppercase;letter-spacing:.06em;">HQ · Location 1</span>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#fff;font-size:1rem;">205 S Seminary St, Florence AL 35630</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start;" class="map-grid">
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#22C55E;margin-bottom:14px;">Response Times — Shoals & West</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            {[
              { city:'Florence',      time:'10–20 min', tier:1 },
              { city:'Sheffield',     time:'10–20 min', tier:1 },
              { city:'Tuscumbia',     time:'10–20 min', tier:1 },
              { city:'Muscle Shoals', time:'10–20 min', tier:1 },
              { city:'Killen',        time:'20–30 min', tier:2 },
              { city:'Leighton',      time:'20–30 min', tier:2 },
              { city:'Russellville',  time:'35–50 min', tier:3 },
              { city:'Huntsville',    time:'40–55 min', tier:4 },
              { city:'Madison',       time:'45–60 min', tier:4 },
              { city:'Athens',        time:'45–60 min', tier:4 },
              { city:'Decatur',       time:'50–65 min', tier:4 },
              { city:'Hartselle',     time:'55–70 min', tier:4 },
            ].map(c => {
              const colors = ['#22C55E','#4ADE80','#86EFAC','#E18B2B'];
              const col = colors[c.tier - 1];
              return (
                <div style="display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:9px 14px;">
                  <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;color:#fff;">{c.city}, AL</span>
                  <span style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:${col};background:${col}18;padding:3px 10px;border-radius:100px;`}>{c.time}</span>
                </div>
              );
            })}
          </div>
        </div>
        <div>
          <div style="border-radius:14px;overflow:hidden;border:2px solid rgba(255,255,255,.1);">
            <iframe
              title="BamaClean Florence HQ — Shoals Service Area"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d206438.54!2d-88.0!3d34.80!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88626b7c7a77fe91%3A0xc3b98a74bf29c3d3!2s205%20S%20Seminary%20St%2C%20Florence%2C%20AL%2035630!5e0!3m2!1sen!2sus!4v1713400000000"
              width="100%"
              height="320"
              style="border:0;display:block;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:16px 20px;margin-top:14px;">
            {[
              { dot:'#22C55E', label:'10–20 min — Shoals (immediate dispatch)' },
              { dot:'#4ADE80', label:'20–30 min — North Lauderdale / Colbert' },
              { dot:'#86EFAC', label:'35–50 min — Russellville / Franklin Co.' },
              { dot:'#E18B2B', label:'40–70 min — Tennessee Valley cities' },
            ].map(k => (
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                <span style={`width:11px;height:11px;border-radius:50%;background:${k.dot};flex-shrink:0;display:inline-block;`}></span>
                <span style="font-size:.8rem;color:rgba(255,255,255,.65);">{k.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ── LOCATION 2: Madison ── -->
    <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:36px;">
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:28px;">
        <span style="background:#3B82F6;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:800;padding:4px 14px;border-radius:100px;text-transform:uppercase;letter-spacing:.06em;">Location 2</span>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#fff;font-size:1rem;">13234 Hwy 243, Madison AL 35757</p>
      </div>

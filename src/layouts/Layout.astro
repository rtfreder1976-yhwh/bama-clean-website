---
import '../styles/global.css';
import QuoteForm from '../components/QuoteForm.astro';
import SocialProof from '../components/SocialProof.astro';

const SITE = 'https://bamaclean.com';

export interface Props {
  title: string;
  description?: string;
  canonical: string;
}
const { title, description = "Professional carpet cleaning, tile & grout cleaning, upholstery cleaning, water damage restoration, and mold inspection in Madison, Huntsville & North Alabama. Call (256) 324-0492.", canonical } = Astro.props;
const canonicalURL = `${SITE}${canonical}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0F1B2D" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Preload LCP asset (nav logo, above the fold on every page) -->
  <link rel="preload" as="image" href="/images/logo.webp" fetchpriority="high" />

  <!-- DNS prefetch / preconnect for third-party origins -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

  <!-- Google Fonts — display=swap prevents invisible text during load -->
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Critical above-fold CSS inlined to eliminate render-blocking -->
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
    body{font-family:'DM Sans',system-ui,sans-serif;color:#1E293B;background:#fff;line-height:1.65;-webkit-font-smoothing:antialiased}
    h1,h2,h3,h4,h5,h6{font-family:'Plus Jakarta Sans',system-ui,sans-serif;line-height:1.2}
    a{text-decoration:none;color:inherit}
    img{max-width:100%;height:auto;display:block}
    /* Utility bar */
    .ub{background:#0F1B2D;color:#fff;padding:10px 24px}
    .ub-inner{max-width:1280px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
    /* Sticky header */
    .site-header{position:sticky;top:0;z-index:90;background:#fff;border-bottom:1px solid #E2E8F0;box-shadow:0 4px 16px rgba(0,0,0,.08)}
    .site-header-inner{max-width:1280px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;height:80px}
    /* Hero gradient (used on every page) */
    .page-hero{background:linear-gradient(135deg,#0F1B2D 0%,#1A2A42 100%);color:#fff}
    /* Prevent layout shift on logo */
    .nav-logo{height:56px;width:auto;aspect-ratio:auto}
    /* Mobile nav toggle */
    .nav-links{display:flex;align-items:center;gap:4px;font-family:'Plus Jakarta Sans',sans-serif}
    .nav-toggle{display:none;background:none;border:none;cursor:pointer;padding:8px;color:#334155}
    @media(max-width:768px){
      .nav-links{display:none;position:absolute;top:80px;left:0;right:0;background:#fff;flex-direction:column;align-items:stretch;padding:16px;gap:4px;border-bottom:1px solid #E2E8F0;box-shadow:0 8px 24px rgba(0,0,0,.1)}
      .nav-links.open{display:flex}
      .nav-toggle{display:flex;align-items:center;justify-content:center}
      .site-header{position:sticky;top:0}
    }
  </style>

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://bamaclean.com/images/logo.webp" />
  <meta property="og:site_name" content="BamaClean" />

  <!-- Google Analytics deferred — does not block render -->
  <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-GTGLLFNDXW"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GTGLLFNDXW');
  </script>

  <!-- LocalBusiness + Service Catalog Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "BamaClean",
    "legalName": "BamaClean, Inc.",
    "description": "Professional carpet cleaning, tile & grout cleaning, upholstery cleaning, water damage restoration, mold inspection and remediation, and fire & smoke damage cleanup in North Alabama.",
    "url": "https://bamaclean.com",
    "telephone": "+12563240492",
    "email": "info@bamaclean.com",
    "foundingDate": "1985",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "205 S Seminary St",
      "addressLocality": "Florence",
      "addressRegion": "AL",
      "postalCode": "35630",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 34.7998,
      "longitude": -87.6773
    },
    "areaServed": [
      {"@type":"City","name":"Madison","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Huntsville","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Florence","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Muscle Shoals","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Decatur","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Athens","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Tuscumbia","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Sheffield","containedInPlace":{"@type":"State","name":"Alabama"}},
      {"@type":"City","name":"Russellville","containedInPlace":{"@type":"State","name":"Alabama"}}
    ],
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "07:00",
        "closes": "22:00"
      }
    ],
    "priceRange": "$$",
    "currenciesAccepted": "USD",
    "paymentAccepted": "Cash, Check, Credit Card",
    "image": "https://bamaclean.com/images/logo.webp",
    "logo": "https://bamaclean.com/images/logo.webp",
    "sameAs": [
      "https://www.facebook.com/people/BamaCleancom-Cleaning-Sanitation-Services/100063969132518/",
      "https://www.instagram.com/bamacleanteam/"
    ],
    "founder": {
      "@type": "Person",
      "name": "AJ Ruiz",
      "jobTitle": "Owner & Operator"
    },
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "name": "IICRC Certified Firm" },
      { "@type": "EducationalOccupationalCredential", "name": "IICRC Water Damage Restoration Technician (WRT)" },
      { "@type": "EducationalOccupationalCredential", "name": "IICRC Applied Microbial Remediation Technician (AMRT)" },
      { "@type": "EducationalOccupationalCredential", "name": "EPA LEAD Certified" },
      { "@type": "EducationalOccupationalCredential", "name": "Green Seal Certified Products" }
    ],
    "memberOf": { "@type": "Organization", "name": "Better Business Bureau" },
    "identifier": [
      { "@type": "PropertyValue", "name": "SAM UEI", "value": "MKPLF7TJPFA4" },
      { "@type": "PropertyValue", "name": "CAGE Code", "value": "5FWC1" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "BamaClean Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Carpet Cleaning",
            "description": "Professional hot-water extraction carpet cleaning for residential and commercial properties. Removes dirt, allergens, pet stains, and odors.",
            "url": "https://bamaclean.com/services#carpet",
            "serviceType": "Carpet Cleaning",
            "areaServed": "North Alabama"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Tile & Grout Cleaning",
            "description": "High-pressure steam cleaning that restores tile and grout to like-new condition. Kitchen, bathroom, floor, and shower tile.",
            "url": "https://bamaclean.com/services#tile",
            "serviceType": "Tile Cleaning",
            "areaServed": "North Alabama"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Upholstery Cleaning",
            "description": "Safe, fabric-tested upholstery cleaning for sofas, chairs, sectionals, and ottomans. Pet odor and stain removal.",
            "url": "https://bamaclean.com/services#upholstery",
            "serviceType": "Upholstery Cleaning",
            "areaServed": "North Alabama"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Water Damage Restoration",
            "description": "24/7 emergency water extraction, structural drying, and full restoration. Fast response across North Alabama.",
            "url": "https://bamaclean.com/services#water",
            "serviceType": "Water Damage Restoration",
            "areaServed": "North Alabama"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Mold Inspection & Remediation",
            "description": "Certified mold inspection, air quality testing, and professional mold remediation for homes and businesses.",
            "url": "https://bamaclean.com/services#mold",
            "serviceType": "Mold Remediation",
            "areaServed": "North Alabama"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Fire & Smoke Damage Cleanup",
            "description": "Comprehensive fire and smoke damage cleanup including soot removal, odor elimination, and structural restoration.",
            "url": "https://bamaclean.com/services#fire",
            "serviceType": "Fire Damage Restoration",
            "areaServed": "North Alabama"
          }
        }
      ]
    }
  }
  </script>

</head>
<body>

  <!-- Utility Bar -->
  <div class="ub">
    <div class="ub-inner">
      <span style="font-size:.8125rem;font-family:'Plus Jakarta Sans',sans-serif;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <span>IICRC Certified · Licensed, Insured &amp; Bonded · Serving North Alabama Since 1985</span>
      </span>
      <a href="tel:+12563240492" style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:1.05rem;color:#22C55E;display:flex;align-items:center;gap:6px;">
        📞 (256) 324-0492
      </a>
    </div>
  </div>

  <!-- Nav -->
  <header class="site-header">
    <div class="site-header-inner" style="position:relative;">
      <a href="/" aria-label="BamaClean home">
        <!-- fetchpriority=high + eager loading: this is the LCP element -->
        <img
          src="/images/logo.webp"
          alt="BamaClean Logo"
          class="nav-logo"
          width="168"
          height="56"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Mobile hamburger -->
      <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <nav class="nav-links" id="nav-links" style="font-family:'Plus Jakarta Sans',sans-serif;">
        <a href="/" style="font-weight:600;padding:8px 14px;border-radius:8px;color:#334155;font-size:.9375rem;">Home</a>
        <a href="/services" style="font-weight:600;padding:8px 14px;border-radius:8px;color:#334155;font-size:.9375rem;">Services</a>
        <a href="/locations" style="font-weight:600;padding:8px 14px;border-radius:8px;color:#334155;font-size:.9375rem;">Locations</a>
        <a href="/about" style="font-weight:600;padding:8px 14px;border-radius:8px;color:#334155;font-size:.9375rem;">About</a>
        <a href="/blog" style="font-weight:600;padding:8px 14px;border-radius:8px;color:#334155;font-size:.9375rem;">Blog</a>
        <a href="#quote" style="background:#1B7A3D;color:#fff;font-weight:700;padding:10px 22px;border-radius:100px;margin-left:8px;font-size:.9375rem;">Get a Quote</a>
      </nav>
    </div>
  </header>

  <script>
    // Mobile nav toggle — tiny, no framework needed
    const toggle = document.getElementById('nav-toggle');
    const links = document.getElementById('nav-links');
    toggle?.addEventListener('click', () => {
      const open = links?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  </script>

  <slot />

  <SocialProof />

  <QuoteForm />

  <!-- Footer -->
  <footer style="background:#0F1B2D;color:rgba(255,255,255,.75);padding:60px 24px 32px;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:48px;margin-bottom:48px;">
        <div>
          <img src="/images/logo.webp" alt="BamaClean" width="144" height="48" loading="lazy" decoding="async" style="height:48px;width:auto;margin-bottom:16px;filter:brightness(0) invert(1);" />
          <p style="font-size:.9rem;line-height:1.6;">Professional cleaning & restoration services across North Alabama since 1993.</p>
        </div>
        <div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;color:#fff;font-size:1rem;font-weight:700;margin-bottom:16px;text-transform:uppercase;letter-spacing:.06em;">Services</h3>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:8px;font-size:.9rem;">
            <li><a href="/services#carpet" style="color:rgba(255,255,255,.75);transition:color .2s;">Carpet Cleaning</a></li>
            <li><a href="/services#tile" style="color:rgba(255,255,255,.75);">Tile & Grout Cleaning</a></li>
            <li><a href="/services#upholstery" style="color:rgba(255,255,255,.75);">Upholstery Cleaning</a></li>
            <li><a href="/services#water" style="color:rgba(255,255,255,.75);">Water Damage Restoration</a></li>
            <li><a href="/services#mold" style="color:rgba(255,255,255,.75);">Mold Inspection & Removal</a></li>
            <li><a href="/blog" style="color:rgba(255,255,255,.75);">Pricing Guides & Blog</a></li>
          </ul>
        </div>
        <div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;color:#fff;font-size:1rem;font-weight:700;margin-bottom:16px;text-transform:uppercase;letter-spacing:.06em;">Service Areas</h3>
          <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:8px;font-size:.9rem;">
            <li><a href="/locations/madison/" style="color:rgba(255,255,255,.75);">Madison, AL</a></li>
            <li><a href="/locations/huntsville/" style="color:rgba(255,255,255,.75);">Huntsville, AL</a></li>
            <li><a href="/locations/florence/" style="color:rgba(255,255,255,.75);">Florence, AL</a></li>
            <li><a href="/locations/decatur/" style="color:rgba(255,255,255,.75);">Decatur, AL</a></li>
            <li><a href="/locations/" style="color:rgba(255,255,255,.75);">All Locations →</a></li>
          </ul>
        </div>
        <div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;color:#fff;font-size:1rem;font-weight:700;margin-bottom:16px;text-transform:uppercase;letter-spacing:.06em;">Contact</h3>
          <p style="font-size:.9rem;margin-bottom:8px;">205 S Seminary St<br/>Florence, AL 35630</p>
          <a href="tel:+12563240492" style="color:#22C55E;font-weight:700;font-size:1.1rem;display:block;margin-bottom:8px;">(256) 324-0492</a>
          <a href="/contact" style="color:rgba(255,255,255,.75);font-size:.9rem;">Send a Message →</a>
        </div>
      </div>
      <!-- Owner / Trust Section -->
      <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:40px;margin-bottom:40px;display:flex;align-items:center;gap:32px;flex-wrap:wrap;">
        <img
          src="/images/aj-ruiz.webp"
          alt="AJ Ruiz, Owner of BamaClean"
          width="100"
          height="100"
          loading="lazy"
          decoding="async"
          style="width:100px;height:100px;border-radius:50%;object-fit:cover;object-position:top;border:3px solid #22C55E;flex-shrink:0;"
        />
        <div style="flex:1;min-width:220px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.0625rem;font-weight:700;color:#fff;margin-bottom:4px;">AJ Ruiz — Owner &amp; Operator</p>
          <p style="font-size:.875rem;color:rgba(255,255,255,.7);line-height:1.6;margin-bottom:10px;">Family-owned and Hispanic American-owned since 1985. Every job carries my name — and my guarantee. If it's not right, we make it right.</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <span style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:4px 12px;font-size:.75rem;font-family:'Plus Jakarta Sans',sans-serif;color:rgba(255,255,255,.85);">IICRC Certified</span>
            <span style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:4px 12px;font-size:.75rem;font-family:'Plus Jakarta Sans',sans-serif;color:rgba(255,255,255,.85);">LEAD Certified</span>
            <span style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:4px 12px;font-size:.75rem;font-family:'Plus Jakarta Sans',sans-serif;color:rgba(255,255,255,.85);">Licensed, Insured &amp; Bonded</span>
            <span style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:4px 12px;font-size:.75rem;font-family:'Plus Jakarta Sans',sans-serif;color:rgba(255,255,255,.85);">BBB Member</span>
            <span style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:4px 12px;font-size:.75rem;font-family:'Plus Jakarta Sans',sans-serif;color:rgba(255,255,255,.85);">Green Seal Products</span>
            <span style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:100px;padding:4px 12px;font-size:.75rem;font-family:'Plus Jakarta Sans',sans-serif;color:rgba(255,255,255,.85);">Family-Owned Since 1985</span>
          </div>
        </div>
      </div>

      <!-- Trust Credential Bar -->
      <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:24px;margin-bottom:24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:20px;text-align:center;">
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#22C55E;">40+</p>
          <p style="font-size:.8rem;color:rgba(255,255,255,.6);margin-top:2px;">Years in Business</p>
        </div>
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#22C55E;">IICRC</p>
          <p style="font-size:.8rem;color:rgba(255,255,255,.6);margin-top:2px;">Certified Firm</p>
        </div>
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#22C55E;">100%</p>
          <p style="font-size:.8rem;color:rgba(255,255,255,.6);margin-top:2px;">Satisfaction Guarantee</p>
        </div>
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#22C55E;">24/7</p>
          <p style="font-size:.8rem;color:rgba(255,255,255,.6);margin-top:2px;">Emergency Response</p>
        </div>
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#22C55E;">Licensed</p>
          <p style="font-size:.8rem;color:rgba(255,255,255,.6);margin-top:2px;">Insured &amp; Bonded</p>
        </div>
        <div>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#22C55E;">No Subs</p>
          <p style="font-size:.8rem;color:rgba(255,255,255,.6);margin-top:2px;">In-House Crew Only</p>
        </div>
      </div>

      <!-- Copyright -->
      <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:.8125rem;">
        <p>© {new Date().getFullYear()} BamaClean, Inc. All rights reserved. · Family-Owned Since 1985</p>
        <p style="color:rgba(255,255,255,.5);">"It's Not Clean Until It's BamaClean."</p>
      </div>
    </div>
  </footer>

</body>
</html>

---
import Layout from '../layouts/Layout.astro';

const locations = [
  {
    slug: 'madison',
    city: 'Madison',
    zip: '35756–35759',
    response: '30–45 min',
    highlight: 'BamaClean\'s most-served suburb. Hunters Ridge, Providence, Redstone Village, and all Madison zip codes.',
    tags: ['Carpet Cleaning', 'Water Damage', 'Mold', 'Radon Testing'],
    priority: true,
  },
  {
    slug: 'huntsville',
    city: 'Huntsville',
    zip: '35801–35824',
    response: '25–40 min',
    highlight: 'All Huntsville neighborhoods — Twickenham, Hampton Cove, Five Points, Jones Valley, Research Park.',
    tags: ['Carpet Cleaning', 'Water Damage', 'Mold', 'Historic Hardwood'],
    priority: true,
  },
  {
    slug: 'florence',
    city: 'Florence',
    zip: '35630–35634',
    response: '15–25 min',
    highlight: 'BamaClean\'s headquarters city. Fastest response in North Alabama. Pope Ave, Cox Creek, Westside, UNA area.',
    tags: ['All Services', '24/7 Emergency', 'Fastest Response'],
    priority: true,
  },
  {
    slug: 'decatur',
    city: 'Decatur',
    zip: '35601–35603',
    response: '35–55 min',
    highlight: 'Old Decatur, Kingsway Historic District, Point Mallard, Beltline Road — all of Morgan County\'s largest city.',
    tags: ['Carpet Cleaning', 'Water Damage', 'Mold', 'Commercial'],
    priority: true,
  },
  {
    slug: 'athens',
    city: 'Athens',
    zip: '35611–35613',
    response: '30–45 min',
    highlight: 'Limestone County\'s highest radon risk area. MTMUS workforce families. Historic downtown to new subdivisions.',
    tags: ['Radon Testing', 'Carpet Cleaning', 'Mold', 'MTMUS Area'],
    priority: true,
  },
  {
    slug: 'muscle-shoals',
    city: 'Muscle Shoals',
    zip: '35661–35662',
    response: '15–25 min',
    highlight: 'Wilson Reservoir area — high crawlspace mold risk. Jackson Highway corridor, Executive Hills, Northbrook.',
    tags: ['Carpet Cleaning', 'Mold Inspection', 'Water Damage', 'Radon'],
    priority: false,
  },
  {
    slug: 'russellville',
    city: 'Russellville',
    zip: '35653–35654',
    response: '40–60 min',
    highlight: 'Franklin County hub. Older crawlspace homes with real mold risk. Professional results at honest prices.',
    tags: ['Carpet Cleaning', 'Mold Inspection', 'Water Damage'],
    priority: false,
  },
  {
    slug: 'sheffield',
    city: 'Sheffield',
    zip: '35660',
    response: '15–25 min',
    highlight: 'Quad City — 15 minutes from BamaClean HQ. Mid-century homes. Helen Keller Hospital area.',
    tags: ['Carpet Cleaning', 'Mold', 'Hardwood Floors', 'Water Damage'],
    priority: false,
  },
  {
    slug: 'tuscumbia',
    city: 'Tuscumbia',
    zip: '35674',
    response: '15–25 min',
    highlight: 'Colbert County seat. Historic Ivy Green district. Finish-aware care for antebellum and craftsman homes.',
    tags: ['Historic Homes', 'Carpet Cleaning', 'Hardwood', 'Mold'],
    priority: false,
  },
  {
    slug: 'killen',
    city: 'Killen',
    zip: '35645',
    response: '20–35 min',
    highlight: 'North Lauderdale County. Limestone geology — elevated radon risk. Elk River area communities.',
    tags: ['Radon Testing', 'Carpet Cleaning', 'Mold Inspection'],
    priority: false,
  },
  {
    slug: 'leighton',
    city: 'Leighton',
    zip: '35646',
    response: '20–35 min',
    highlight: 'Colbert County Tennessee River communities. Cherokee and Barton included. Rural residential expertise.',
    tags: ['Carpet Cleaning', 'Mold Inspection', 'Radon Testing'],
    priority: false,
  },
  {
    slug: 'hartselle',
    city: 'Hartselle',
    zip: '35640',
    response: '50–65 min',
    highlight: 'South Morgan County. Hartselle City Schools area. Priceville and Trinity included.',
    tags: ['Carpet Cleaning', 'Mold Inspection', 'Water Damage'],
    priority: false,
  },
];
---

<Layout
  title="Service Areas | North Alabama Carpet Cleaning & Restoration | BamaClean"
  description="BamaClean serves Madison, Huntsville, Florence, Decatur, Athens, Muscle Shoals, Russellville, Sheffield, Tuscumbia, Killen, Leighton, Hartselle & all of North Alabama. (256) 324-0492."
  canonical="/locations/"
>

  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#0F1B2D 0%,#1A2A42 100%);color:#fff;padding:72px 24px;text-align:center;">
    <div style="max-width:800px;margin:0 auto;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#22C55E;margin-bottom:12px;">Where We Work</p>
      <h1 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:800;margin-bottom:16px;">Serving All of North Alabama Since 1993</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,.8);line-height:1.7;margin-bottom:28px;">IICRC-certified carpet cleaning, tile & grout, water damage restoration, mold remediation, radon testing, and more — across 12+ communities in the Tennessee Valley and Shoals. Each city has its own dedicated page with local details, neighborhood information, and city-specific content.</p>
      <a href="tel:+12563240492" style="background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:14px 32px;border-radius:100px;font-size:1rem;">📞 Call (256) 324-0492</a>
    </div>
  </section>

  <!-- Primary Markets -->
  <section style="padding:72px 24px;background:#fff;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Primary Service Areas</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;">Our Highest-Coverage Cities</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(360px,1fr));gap:24px;margin-bottom:64px;">
        {locations.filter(l => l.priority).map(l => (
          <a href={`/locations/${l.slug}/`} style="display:block;background:#fff;border:2px solid #E8F5EC;border-radius:18px;padding:32px;text-decoration:none;box-shadow:0 2px 16px rgba(0,0,0,.06);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
              <div>
                <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.375rem;font-weight:800;color:#0F1B2D;">{l.city}, AL</h3>
                <p style="font-size:.8125rem;color:#94A3B8;font-weight:500;margin-top:2px;">ZIP: {l.zip}</p>
              </div>
              <div style="background:#E8F5EC;border-radius:10px;padding:10px 14px;text-align:center;">
                <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.7rem;font-weight:700;color:#1B7A3D;text-transform:uppercase;letter-spacing:.06em;">Response</p>
                <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.9rem;font-weight:800;color:#1B7A3D;">{l.response}</p>
              </div>
            </div>
            <p style="font-size:.9375rem;color:#475569;line-height:1.65;margin-bottom:20px;">{l.highlight}</p>
            <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:20px;">
              {l.tags.map(tag => (
                <span style="background:#F1F5F9;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:600;padding:4px 11px;border-radius:100px;">{tag}</span>
              ))}
            </div>
            <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.9375rem;color:#1B7A3D;">View {l.city} Page →</span>
          </a>
        ))}
      </div>

      <div style="text-align:center;margin-bottom:48px;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Additional Coverage</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;">More Communities We Serve</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;">
        {locations.filter(l => !l.priority).map(l => (
          <a href={`/locations/${l.slug}/`} style="display:block;background:#F8FAFB;border:1px solid #E2E8F0;border-radius:14px;padding:24px;text-decoration:none;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
              <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;">{l.city}, AL</h3>
              <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:700;color:#1B7A3D;background:#E8F5EC;padding:4px 10px;border-radius:100px;">{l.response}</span>
            </div>
            <p style="font-size:.875rem;color:#475569;line-height:1.6;margin-bottom:14px;">{l.highlight}</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px;">
              {l.tags.map(tag => (
                <span style="background:#fff;color:#475569;font-family:'Plus Jakarta Sans',sans-serif;font-size:.75rem;font-weight:500;padding:3px 10px;border-radius:100px;border:1px solid #E2E8F0;">{tag}</span>
              ))}
            </div>
            <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.875rem;color:#1B7A3D;">View {l.city} Page →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Response Time — Two Locations -->
  <section style="padding:72px 24px;background:#F1F5F9;">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:48px;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:12px;">Emergency Response</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;margin-bottom:16px;">Two Locations — Fastest Coverage Across North Alabama</h2>
        <p style="color:#475569;font-size:1rem;max-width:680px;margin:0 auto;">BamaClean dispatches from whichever location gets to you fastest. Florence HQ covers the Shoals; Madison covers Huntsville, Madison City, and the eastern Tennessee Valley.</p>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;" class="loc-grid">

        <!-- Florence HQ -->
        <div>
          <div style="background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;padding:10px 20px;border-radius:12px 12px 0 0;text-align:center;">HQ · Florence, AL — 205 S Seminary St</div>
          <div style="background:#fff;border-radius:0 0 12px 12px;padding:20px;box-shadow:0 2px 16px rgba(0,0,0,.07);">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              {[
                {city:'Florence',      time:'10–20 min', color:'#1B7A3D'},
                {city:'Sheffield',     time:'10–20 min', color:'#1B7A3D'},
                {city:'Tuscumbia',     time:'10–20 min', color:'#1B7A3D'},
                {city:'Muscle Shoals', time:'10–20 min', color:'#1B7A3D'},
                {city:'Killen',        time:'20–30 min', color:'#2D8A50'},
                {city:'Leighton',      time:'20–30 min', color:'#2D8A50'},
                {city:'Russellville',  time:'35–50 min', color:'#3D9A60'},
                {city:'Huntsville',    time:'40–55 min', color:'#E18B2B'},
                {city:'Madison',       time:'45–60 min', color:'#E18B2B'},
                {city:'Athens',        time:'45–60 min', color:'#E18B2B'},
                {city:'Decatur',       time:'50–65 min', color:'#C05A1F'},
                {city:'Hartselle',     time:'55–70 min', color:'#C05A1F'},
              ].map(r => (
                <div style="background:#F8FAFB;border-radius:10px;padding:12px 14px;border:1px solid #E2E8F0;">
                  <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#0F1B2D;margin-bottom:3px;">{r.city}, AL</p>
                  <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:800;color:${r.color}`}>{r.time}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Madison Location -->
        <div>
          <div style="background:#1D4ED8;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;padding:10px 20px;border-radius:12px 12px 0 0;text-align:center;">Location 2 · Madison, AL — 13234 Hwy 243</div>
          <div style="background:#fff;border-radius:0 0 12px 12px;padding:20px;box-shadow:0 2px 16px rgba(0,0,0,.07);">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
              {[
                {city:'Madison',       time:'10–15 min', color:'#1D4ED8'},
                {city:'Huntsville',    time:'15–25 min', color:'#1D4ED8'},
                {city:'Athens',        time:'20–30 min', color:'#2563EB'},
                {city:'Decatur',       time:'30–45 min', color:'#3B82F6'},
                {city:'Hartselle',     time:'40–55 min', color:'#3B82F6'},
                {city:'Florence',      time:'45–60 min', color:'#E18B2B'},
                {city:'Sheffield',     time:'45–60 min', color:'#E18B2B'},
                {city:'Tuscumbia',     time:'45–60 min', color:'#E18B2B'},
                {city:'Muscle Shoals', time:'45–60 min', color:'#E18B2B'},
                {city:'Killen',        time:'50–65 min', color:'#C05A1F'},
                {city:'Leighton',      time:'50–65 min', color:'#C05A1F'},
                {city:'Russellville',  time:'60–75 min', color:'#C05A1F'},
              ].map(r => (
                <div style="background:#F8FAFB;border-radius:10px;padding:12px 14px;border:1px solid #E2E8F0;">
                  <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#0F1B2D;margin-bottom:3px;">{r.city}, AL</p>
                  <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:800;color:${r.color}`}>{r.time}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <style>
    @media (max-width: 640px) { .loc-grid { grid-template-columns: 1fr !important; } }
  </style>

  <!-- CTA -->
  <section style="background:linear-gradient(135deg,#1B7A3D 0%,#145C2E 100%);color:#fff;padding:72px 24px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;margin-bottom:16px;">Not Sure We Cover Your Area?</h2>
      <p style="font-size:1.125rem;color:rgba(255,255,255,.85);margin-bottom:40px;">Call us — we serve many communities beyond this list and can often confirm coverage for your address in under a minute.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="tel:+12563240492" style="background:#fff;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;padding:16px 36px;border-radius:100px;font-size:1rem;">Call (256) 324-0492</a>
        <a href="/contact" style="background:transparent;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:16px 36px;border-radius:100px;border:2px solid rgba(255,255,255,.5);font-size:1rem;">Send a Message</a>
      </div>
    </div>
  </section>

</Layout>

---
// QuoteForm.astro — consumer-facing quote request form
// Submission: Formspree endpoint placeholder (wire up when ready)
// Chat: GoHighLevel placeholder embed (not wired)
---

<!-- ===== EMERGENCY BANNER ===== -->
<div id="emergency-banner" style="background:#C0392B;color:#fff;padding:10px 20px;text-align:center;font-family:'Plus Jakarta Sans',sans-serif;font-size:.875rem;font-weight:600;display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;position:relative;">
  <span>🚨 <strong>24/7 Emergency Response</strong> — Water damage, fire, or flooding? We dispatch immediately.</span>
  <a href="tel:+12563240492" style="background:#fff;color:#C0392B;padding:6px 18px;border-radius:100px;font-weight:800;font-size:.875rem;white-space:nowrap;">Call Now: (256) 324-0492</a>
  <button id="dismiss-banner" aria-label="Dismiss" style="background:none;border:none;color:rgba(255,255,255,.7);font-size:1.25rem;cursor:pointer;position:absolute;right:16px;top:50%;transform:translateY(-50%);line-height:1;">×</button>
</div>

<!-- ===== QUOTE FORM SECTION ===== -->
<section id="quote" style="background:#F1F5F9;padding:72px 24px;">
  <div style="max-width:860px;margin:0 auto;">

    <div style="text-align:center;margin-bottom:40px;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Free — No Obligation</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:#0F1B2D;margin-bottom:12px;">Get Your Free Quote</h2>
      <p style="color:#475569;font-size:1rem;max-width:560px;margin:0 auto;">Tell us what you need. AJ or a certified technician will call you back — usually within the hour during business hours.</p>
    </div>

    <div style="background:#fff;border-radius:20px;box-shadow:0 4px 32px rgba(0,0,0,.08);overflow:hidden;">

      <!-- Trust strip -->
      <div style="background:#0F1B2D;padding:14px 32px;display:flex;justify-content:center;gap:32px;flex-wrap:wrap;">
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;color:rgba(255,255,255,.8);">✓ No obligation</span>
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;color:rgba(255,255,255,.8);">✓ IICRC Certified</span>
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;color:rgba(255,255,255,.8);">✓ Upfront pricing — no surprises</span>
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;color:rgba(255,255,255,.8);">✓ Family-owned since 1985</span>
      </div>

      <form
        id="quote-form"
        action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID"
        method="POST"
        style="padding:40px 40px 32px;"
      >
        <!-- Row 1: Name + Phone -->
        <div class="qf-row" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
          <div>
            <label for="qf-name" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">Your Name *</label>
            <input type="text" id="qf-name" name="name" required placeholder="John Smith" class="qf-input" />
          </div>
          <div>
            <label for="qf-phone" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">Phone Number *</label>
            <input type="tel" id="qf-phone" name="phone" required placeholder="(256) 555-0000" class="qf-input" />
          </div>
        </div>

        <!-- Row 2: Email + City -->
        <div class="qf-row" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
          <div>
            <label for="qf-email" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">Email Address</label>
            <input type="email" id="qf-email" name="email" placeholder="you@email.com" class="qf-input" />
          </div>
          <div>
            <label for="qf-city" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">City / Zip Code *</label>
            <input type="text" id="qf-city" name="city" required placeholder="Madison, AL 35757" class="qf-input" />
          </div>
        </div>

        <!-- Services checkboxes -->
        <div style="margin-bottom:20px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:10px;">Services Needed * <span style="font-weight:400;color:#94A3B8;">(check all that apply)</span></p>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;">
            {[
              'Carpet Cleaning',
              'Tile & Grout Cleaning',
              'Upholstery Cleaning',
              'Hardwood Floor Cleaning',
              'Area Rug Cleaning',
              'Water Damage Restoration',
              'Mold Inspection & Remediation',
              'Fire & Smoke Damage',
              'Radon Testing',
              'Sanitation Services',
              'Commercial Cleaning',
              'Not sure — need advice',
            ].map(svc => (
              <label class="svc-label">
                <input type="checkbox" name="services" value={svc} class="svc-check" />
                {svc}
              </label>
            ))}
          </div>
        </div>

        <!-- Row 4: Date + Urgency -->
        <div class="qf-row" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
          <div>
            <label for="qf-date" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">Preferred Date</label>
            <input type="date" id="qf-date" name="preferred_date" class="qf-input" />
          </div>
          <div>
            <label for="qf-urgency" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">Urgency</label>
            <select id="qf-urgency" name="urgency" class="qf-input">
              <option value="">Select timeframe</option>
              <option value="emergency">🚨 Emergency — need help today</option>
              <option value="asap">This week if possible</option>
              <option value="flexible">Within the next 2–3 weeks</option>
              <option value="planning">Just planning ahead</option>
            </select>
          </div>
        </div>

        <!-- Message -->
        <div style="margin-bottom:28px;">
          <label for="qf-message" style="display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;color:#334155;margin-bottom:6px;">Additional Details</label>
          <textarea id="qf-message" name="message" rows="3" placeholder="Tell us about your home or facility, any special concerns, square footage if known..." class="qf-input" style="resize:vertical;"></textarea>
        </div>

        <!-- Submit row -->
        <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
          <button type="submit" id="qf-submit" class="qf-btn">
            Request My Free Quote →
          </button>
          <p style="font-size:.8125rem;color:#94A3B8;line-height:1.5;">
            Or call: <a href="tel:+12563240492" style="color:#1B7A3D;font-weight:700;">(256) 324-0492</a><br/>We typically respond within the hour.
          </p>
        </div>

        <!-- Success / error feedback -->
        <div id="qf-success" style="display:none;margin-top:20px;background:#E8F5EC;border:1.5px solid #1B7A3D;border-radius:12px;padding:20px 24px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#1B7A3D;margin-bottom:4px;">✓ Request received — thank you!</p>
          <p style="font-size:.9rem;color:#334155;">AJ or a certified technician will call you back shortly. For emergencies, call <a href="tel:+12563240492" style="color:#1B7A3D;font-weight:700;">(256) 324-0492</a> now.</p>
        </div>
        <div id="qf-error" style="display:none;margin-top:20px;background:#FEF2F2;border:1.5px solid #C0392B;border-radius:12px;padding:20px 24px;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;color:#C0392B;margin-bottom:4px;">Something went wrong.</p>
          <p style="font-size:.9rem;color:#334155;">Please call <a href="tel:+12563240492" style="color:#C0392B;font-weight:700;">(256) 324-0492</a> and we'll get you taken care of.</p>
        </div>

      </form>
    </div>

    <div style="text-align:center;margin-top:24px;">
      <a href="tel:+12563240492" style="display:inline-flex;align-items:center;gap:10px;background:#0F1B2D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:1.0625rem;padding:14px 32px;border-radius:100px;text-decoration:none;">
        📞 Prefer to call? (256) 324-0492 — 24/7
      </a>
    </div>

  </div>
</section>

<!-- ===== FLOATING MOBILE CALL BUTTON ===== -->
<a
  href="tel:+12563240492"
  id="mobile-call-fab"
  aria-label="Call BamaClean"
  style="display:none;position:fixed;bottom:88px;right:20px;z-index:200;background:#1B7A3D;color:#fff;width:60px;height:60px;border-radius:50%;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(27,122,61,.5);text-decoration:none;font-size:1.5rem;"
>📞</a>

<!-- ===== DEMO LIVE CHAT WIDGET (GoHighLevel placeholder) ===== -->
<div id="chat-widget" style="position:fixed;bottom:20px;right:20px;z-index:200;font-family:'Plus Jakarta Sans',sans-serif;">
  <button id="chat-trigger" aria-label="Open chat" style="width:60px;height:60px;border-radius:50%;background:#1B7A3D;border:none;cursor:pointer;box-shadow:0 4px 20px rgba(27,122,61,.45);display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:#fff;position:relative;">
    💬
    <span style="position:absolute;top:0;right:0;width:14px;height:14px;background:#22C55E;border-radius:50%;border:2px solid #fff;"></span>
  </button>

  <div id="chat-panel" style="display:none;flex-direction:column;position:absolute;bottom:72px;right:0;width:320px;background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(0,0,0,.18);overflow:hidden;">
    <div style="background:#0F1B2D;padding:16px 20px;display:flex;align-items:center;gap:12px;">
      <img src="/images/aj-ruiz.webp" alt="AJ Ruiz" width="40" height="40" loading="lazy" style="width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:top;border:2px solid #22C55E;" />
      <div>
        <p style="color:#fff;font-weight:700;font-size:.9375rem;margin-bottom:1px;">AJ Ruiz — BamaClean</p>
        <p style="color:#22C55E;font-size:.75rem;">● Typically replies within the hour</p>
      </div>
      <button id="chat-close" style="margin-left:auto;background:none;border:none;color:rgba(255,255,255,.6);font-size:1.25rem;cursor:pointer;line-height:1;">×</button>
    </div>

    <div id="chat-body" style="padding:20px;background:#F8FAFB;">
      <div style="background:#fff;border-radius:12px 12px 12px 4px;padding:12px 14px;font-size:.875rem;color:#334155;line-height:1.6;box-shadow:0 1px 4px rgba(0,0,0,.06);margin-bottom:12px;">
        Hey! I'm AJ. What can BamaClean help you with today?
      </div>
      <div id="chat-options" style="display:flex;flex-direction:column;gap:8px;">
        <button class="chat-opt" data-opt="Get a free quote">Get a free quote</button>
        <button class="chat-opt" data-opt="Water damage — need help now">Water damage — need help now</button>
        <button class="chat-opt" data-opt="Carpet cleaning pricing">Carpet cleaning pricing</button>
        <button class="chat-opt" data-opt="Mold inspection">Mold inspection</button>
      </div>
    </div>

    <div style="padding:12px 16px;border-top:1px solid #E2E8F0;display:flex;gap:8px;background:#fff;">
      <input id="chat-input" type="text" placeholder="Type a message..." style="flex:1;border:1.5px solid #E2E8F0;border-radius:100px;padding:9px 14px;font-size:.875rem;font-family:'DM Sans',sans-serif;outline:none;" />
      <button id="chat-send" style="background:#1B7A3D;color:#fff;border:none;border-radius:50%;width:38px;height:38px;cursor:pointer;font-size:1rem;flex-shrink:0;">→</button>
    </div>

    <div style="background:#F1F5F9;padding:8px 16px;text-align:center;font-size:.7rem;color:#94A3B8;">
      Powered by GoHighLevel · Live chat coming soon
    </div>
  </div>
</div>

<script>
(function () {
  // --- Banner dismiss ---
  document.getElementById('dismiss-banner')?.addEventListener('click', function () {
    document.getElementById('emergency-banner').style.display = 'none';
  });

  // --- Mobile FAB ---
  var fab = document.getElementById('mobile-call-fab');
  function updateFab() {
    if (fab) fab.style.display = window.innerWidth < 768 ? 'flex' : 'none';
  }
  updateFab();
  window.addEventListener('resize', updateFab);

  // --- Chat toggle ---
  var trigger = document.getElementById('chat-trigger');
  var panel = document.getElementById('chat-panel');
  var closeBtn = document.getElementById('chat-close');
  trigger?.addEventListener('click', function () {
    panel.style.display = panel.style.display === 'flex' ? 'none' : 'flex';
  });
  closeBtn?.addEventListener('click', function () {
    panel.style.display = 'none';
  });

  // --- Chat quick replies ---
  var replies = {
    'Get a free quote': 'Great! Scroll up to fill out our quick quote form, or call us at (256) 324-0492 and we\'ll get you a number fast.',
    'Water damage — need help now': 'Call us NOW at (256) 324-0492 — we dispatch 24/7 for water damage emergencies. Every minute counts.',
    'Carpet cleaning pricing': 'We price by square footage with no hidden fees. Fill out the quote form above and we\'ll give you an exact number — usually within the hour.',
    'Mold inspection': 'We do IICRC-certified mold inspections throughout North Alabama. Fill out the quote form and we\'ll schedule your inspection.',
  };

  function showReply(msg) {
    var body = document.getElementById('chat-body');
    if (!body) return;

    var bubble = document.createElement('div');
    bubble.style.cssText = 'background:#fff;border-radius:12px 12px 12px 4px;padding:12px 14px;font-size:.875rem;color:#334155;line-height:1.6;box-shadow:0 1px 4px rgba(0,0,0,.06);margin-bottom:12px;';
    bubble.textContent = msg;

    var callLink = document.createElement('a');
    callLink.href = 'tel:+12563240492';
    callLink.style.cssText = 'display:block;margin-top:12px;background:#1B7A3D;color:#fff;text-align:center;padding:10px;border-radius:100px;font-family:\'Plus Jakarta Sans\',sans-serif;font-weight:700;font-size:.875rem;text-decoration:none;';
    callLink.textContent = '📞 Call (256) 324-0492';

    body.textContent = '';
    body.appendChild(bubble);
    body.appendChild(callLink);
  }

  document.querySelectorAll('.chat-opt').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var opt = btn.getAttribute('data-opt');
      showReply(replies[opt] || 'Thanks! Call us at (256) 324-0492 or fill out the quote form above.');
    });
  });

  document.getElementById('chat-send')?.addEventListener('click', function () {
    var input = document.getElementById('chat-input');
    if (input && input.value.trim()) {
      showReply('Thanks for your message! For the fastest response, call us at (256) 324-0492 or fill out the quote form above.');
      input.value = '';
    }
  });

  document.getElementById('chat-input')?.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') document.getElementById('chat-send')?.click();
  });

  // --- Quote form submission ---
  var form = document.getElementById('quote-form');
  form?.addEventListener('submit', async function (e) {
    e.preventDefault();
    var btn = document.getElementById('qf-submit');
    var success = document.getElementById('qf-success');
    var error = document.getElementById('qf-error');
    btn.textContent = 'Sending...';
    btn.disabled = true;
    try {
      var res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' },
      });
      if (res.ok) {
        form.reset();
        success.style.display = 'block';
        error.style.display = 'none';
        btn.textContent = '✓ Sent!';
      } else {
        throw new Error('non-ok');
      }
    } catch (_) {
      error.style.display = 'block';
      success.style.display = 'none';
      btn.textContent = 'Request My Free Quote →';
      btn.disabled = false;
    }
  });
})();
</script>

<style>
  .qf-input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #CBD5E1;
    border-radius: 10px;
    font-size: .9375rem;
    font-family: 'DM Sans', sans-serif;
    color: #1E293B;
    outline: none;
    background: #fff;
    transition: border-color .2s;
  }
  .qf-input:focus { border-color: #1B7A3D; }
  select.qf-input { background: #fff; }
  .qf-btn {
    background: #1B7A3D;
    color: #fff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    font-size: 1.0625rem;
    padding: 16px 40px;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: background .2s;
    white-space: nowrap;
  }
  .qf-btn:hover { background: #145C2E; }
  .qf-btn:disabled { opacity: .7; cursor: not-allowed; }
  .svc-label {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 10px 13px;
    border: 1.5px solid #E2E8F0;
    border-radius: 9px;
    cursor: pointer;
    font-size: .875rem;
    font-family: 'DM Sans', sans-serif;
    color: #334155;
    user-select: none;
    transition: border-color .15s, background .15s;
    background: #fff;
  }
  .svc-label:hover { border-color: #1B7A3D; background: #F0FAF4; }
  .svc-check { width: 16px; height: 16px; accent-color: #1B7A3D; cursor: pointer; flex-shrink: 0; }
  .svc-check:checked + span, .svc-label:has(.svc-check:checked) { border-color: #1B7A3D; background: #F0FAF4; font-weight: 600; }
  .chat-opt {
    background: #fff;
    border: 1.5px solid #E2E8F0;
    border-radius: 100px;
    padding: 9px 16px;
    font-size: .8125rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    text-align: left;
    transition: border-color .15s, color .15s;
  }
  .chat-opt:hover { border-color: #1B7A3D; color: #1B7A3D; }
  @media (max-width: 600px) {
    .qf-row { grid-template-columns: 1fr !important; }
    #quote form { padding: 24px 20px !important; }
  }
</style>

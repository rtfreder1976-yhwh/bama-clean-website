---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="About BamaClean | Trusted Since 1993 | North Alabama"
  description="BamaClean has proudly served North Alabama since 1993. IICRC-certified, licensed & insured. Learn about our history, values, and commitment to quality cleaning & restoration."
  canonical="/about/"
>

  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#0F1B2D 0%,#1A2A42 100%);color:#fff;padding:72px 24px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#22C55E;margin-bottom:12px;">Our Story</p>
      <h1 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2rem,4vw,3rem);font-weight:800;margin-bottom:16px;">About BamaClean</h1>
      <p style="font-size:1.0625rem;color:rgba(255,255,255,.8);line-height:1.7;">30+ years of professional cleaning and restoration service — built on trust, hard work, and a commitment to the communities of North Alabama.</p>
    </div>
  </section>

  <!-- Our Story -->
  <section style="padding:80px 24px;background:#fff;">
    <div style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:64px;align-items:center;">
      <div>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:12px;">Since 1993</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;margin-bottom:24px;">North Alabama's Trusted Cleaning & Restoration Company</h2>
        <p style="color:#475569;line-height:1.7;margin-bottom:16px;">BamaClean was founded in North Alabama with a simple mission: deliver professional-grade cleaning and restoration results that homeowners and businesses can count on. What started as a small carpet cleaning operation has grown into a full-service cleaning and disaster restoration company serving thousands of customers across the region.</p>
        <p style="color:#475569;line-height:1.7;margin-bottom:16px;">For over 30 years, we've been the company North Alabamians call when they need their carpets deep-cleaned, their tile restored, water damage handled fast, or mold identified and removed safely. We've built our reputation one job at a time — and we're proud of every single one.</p>
        <p style="color:#475569;line-height:1.7;">From Madison to Florence, Huntsville to Russellville — BamaClean is your neighbor, your cleaner, and your restoration partner.</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div style="background:#E8F5EC;border-radius:16px;padding:32px;text-align:center;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:2.5rem;font-weight:800;color:#1B7A3D;margin-bottom:4px;">30+</p>
          <p style="font-size:.875rem;color:#475569;font-weight:600;">Years in Business</p>
        </div>
        <div style="background:#F1F5F9;border-radius:16px;padding:32px;text-align:center;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:2.5rem;font-weight:800;color:#0F1B2D;margin-bottom:4px;">5,000+</p>
          <p style="font-size:.875rem;color:#475569;font-weight:600;">Customers Served</p>
        </div>
        <div style="background:#F1F5F9;border-radius:16px;padding:32px;text-align:center;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:2.5rem;font-weight:800;color:#0F1B2D;margin-bottom:4px;">9+</p>
          <p style="font-size:.875rem;color:#475569;font-weight:600;">Cities Served</p>
        </div>
        <div style="background:#E8F5EC;border-radius:16px;padding:32px;text-align:center;">
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:2.5rem;font-weight:800;color:#1B7A3D;margin-bottom:4px;">24/7</p>
          <p style="font-size:.875rem;color:#475569;font-weight:600;">Emergency Response</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Values -->
  <section style="padding:80px 24px;background:#F1F5F9;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:56px;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">What Drives Us</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:#0F1B2D;">Our Core Values</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;">
        <div style="background:#fff;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
          <div style="font-size:2.5rem;margin-bottom:16px;">🏆</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Quality First</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;">We use professional-grade equipment and proven techniques to deliver results that exceed expectations — every single time.</p>
        </div>
        <div style="background:#fff;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
          <div style="font-size:2.5rem;margin-bottom:16px;">🤝</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Integrity</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;">We are honest about what we can do, transparent about our pricing, and accountable for our work. No surprises, no upsells.</p>
        </div>
        <div style="background:#fff;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
          <div style="font-size:2.5rem;margin-bottom:16px;">⚡</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Responsiveness</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;">When you have a water emergency at 2am, we answer. When you need a same-day cleaning quote, we respond. Speed matters.</p>
        </div>
        <div style="background:#fff;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);">
          <div style="font-size:2.5rem;margin-bottom:16px;">🌿</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Family Safe</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;">We use eco-friendly, family-safe cleaning solutions throughout our process. Safe for your children, your pets, and the environment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications & Trust -->
  <section style="padding:80px 24px;background:#fff;">
    <div style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:64px;align-items:center;">
      <div>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:12px;">Credentials & Trust</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;color:#0F1B2D;margin-bottom:24px;">Licensed, Certified & Insured</h2>
        <p style="color:#475569;line-height:1.7;margin-bottom:32px;">BamaClean is fully licensed and insured in the state of Alabama. Our technicians are IICRC-certified (Institute of Inspection, Cleaning and Restoration Certification) — the industry's leading professional standard for cleaning and restoration.</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:16px;">
          <li style="display:flex;align-items:center;gap:14px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:28px;height:28px;min-width:28px;background:#E8F5EC;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.875rem;color:#1B7A3D;">✓</span>
            IICRC Certified Technicians
          </li>
          <li style="display:flex;align-items:center;gap:14px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:28px;height:28px;min-width:28px;background:#E8F5EC;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.875rem;color:#1B7A3D;">✓</span>
            Licensed & Insured in Alabama
          </li>
          <li style="display:flex;align-items:center;gap:14px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:28px;height:28px;min-width:28px;background:#E8F5EC;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.875rem;color:#1B7A3D;">✓</span>
            Certified Mold Remediation Specialists
          </li>
          <li style="display:flex;align-items:center;gap:14px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:28px;height:28px;min-width:28px;background:#E8F5EC;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.875rem;color:#1B7A3D;">✓</span>
            Water Damage Restoration Certified
          </li>
          <li style="display:flex;align-items:center;gap:14px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:28px;height:28px;min-width:28px;background:#E8F5EC;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.875rem;color:#1B7A3D;">✓</span>
            100% Satisfaction Guarantee
          </li>
        </ul>
      </div>
      <div style="background:#F1F5F9;border-radius:20px;padding:48px;">
        <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#0F1B2D;margin-bottom:24px;">Our Service Areas</h3>
        <p style="color:#475569;font-size:.9375rem;line-height:1.7;margin-bottom:20px;">BamaClean serves all of North Alabama, including:</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;">
          {['Madison','Huntsville','Florence','Muscle Shoals','Decatur','Athens','Tuscumbia','Sheffield','Russellville','Killen','Hartselle','Cullman'].map(city => (
            <span style="background:#fff;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.8125rem;padding:6px 14px;border-radius:100px;border:1px solid #E8F5EC;">{city}, AL</span>
          ))}
        </div>
        <a href="/locations" style="display:inline-block;background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:12px 28px;border-radius:100px;font-size:.9375rem;">View All Locations</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:linear-gradient(135deg,#1B7A3D 0%,#145C2E 100%);color:#fff;padding:80px 24px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;margin-bottom:16px;">Ready to Experience the BamaClean Difference?</h2>
      <p style="font-size:1.125rem;color:rgba(255,255,255,.85);margin-bottom:40px;">Contact us today for a free quote and see why North Alabama has trusted BamaClean for 30+ years.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/contact" style="background:#fff;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;padding:16px 36px;border-radius:100px;font-size:1rem;">Get a Free Quote</a>
        <a href="tel:+12563240492" style="background:transparent;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:16px 36px;border-radius:100px;border:2px solid rgba(255,255,255,.5);font-size:1rem;">Call (256) 324-0492</a>
      </div>
    </div>
  </section>

</Layout>

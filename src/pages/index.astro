---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Carpet & Restoration Services | North Alabama | BamaClean"
  description="Professional carpet, tile & upholstery cleaning, water damage restoration & mold inspection in Madison, Huntsville & Florence AL. 30+ yrs. Call (256) 324-0492."
  canonical="/"
>

  <!-- Hero -->
  <section style="background:linear-gradient(135deg,#0F1B2D 0%,#1A2A42 100%);color:#fff;padding:100px 24px;text-align:center;">
    <div style="max-width:800px;margin:0 auto;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#22C55E;margin-bottom:16px;">Madison & Huntsville's Most Trusted Cleaners</p>
      <h1 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2.25rem,5vw,3.5rem);font-weight:800;line-height:1.1;margin-bottom:24px;">
        North Alabama's Premier<br/>Carpet & Restoration Experts
      </h1>
      <p style="font-size:1.125rem;color:rgba(255,255,255,.8);max-width:600px;margin:0 auto 40px;line-height:1.7;">
        30+ years of professional carpet cleaning, tile &amp; grout cleaning, upholstery cleaning, water damage restoration, and mold inspection across North Alabama.
      </p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/contact" style="background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:16px 36px;border-radius:100px;font-size:1rem;">Get a Free Quote</a>
        <a href="tel:+12563240492" style="background:transparent;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:16px 36px;border-radius:100px;border:2px solid rgba(255,255,255,.45);font-size:1rem;">📞 (256) 324-0492</a>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section style="background:#F8FAFB;border-bottom:1px solid #E2E8F0;padding:32px 24px;">
    <div style="max-width:1280px;margin:0 auto;display:flex;justify-content:center;align-items:center;gap:48px;flex-wrap:wrap;">
      <div style="text-align:center;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.75rem;font-weight:800;color:#1B7A3D;">30+</p>
        <p style="font-size:.875rem;color:#475569;font-weight:600;">Years Experience</p>
      </div>
      <div style="width:1px;height:40px;background:#E2E8F0;"></div>
      <div style="text-align:center;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.75rem;font-weight:800;color:#1B7A3D;">5,000+</p>
        <p style="font-size:.875rem;color:#475569;font-weight:600;">Happy Customers</p>
      </div>
      <div style="width:1px;height:40px;background:#E2E8F0;"></div>
      <div style="text-align:center;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.75rem;font-weight:800;color:#1B7A3D;">24/7</p>
        <p style="font-size:.875rem;color:#475569;font-weight:600;">Emergency Service</p>
      </div>
      <div style="width:1px;height:40px;background:#E2E8F0;"></div>
      <div style="text-align:center;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.75rem;font-weight:800;color:#1B7A3D;">100%</p>
        <p style="font-size:.875rem;color:#475569;font-weight:600;">Satisfaction Guaranteed</p>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section style="padding:80px 24px;background:#fff;">
    <div style="max-width:1280px;margin:0 auto;">
      <div style="text-align:center;margin-bottom:56px;">
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">What We Do</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:#0F1B2D;">Professional Cleaning & Restoration Services</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        <a href="/services#carpet" style="display:block;background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-decoration:none;color:inherit;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🧹</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Carpet Cleaning</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:16px;">Hot-water extraction deep cleaning that removes dirt, allergens, and stains — leaving your carpet fresh and dry in hours.</p>
          <span style="color:#1B7A3D;font-weight:600;font-size:.875rem;">Learn More →</span>
        </a>
        <a href="/services#tile" style="display:block;background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-decoration:none;color:inherit;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🔲</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Tile & Grout Cleaning</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:16px;">High-pressure cleaning restores tile and grout to like-new condition, removing years of buildup and discoloration.</p>
          <span style="color:#1B7A3D;font-weight:600;font-size:.875rem;">Learn More →</span>
        </a>
        <a href="/services#upholstery" style="display:block;background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-decoration:none;color:inherit;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🛋️</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Upholstery Cleaning</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:16px;">Safe, effective cleaning for sofas, chairs, and fabric surfaces — removing stains and odors without damage.</p>
          <span style="color:#1B7A3D;font-weight:600;font-size:.875rem;">Learn More →</span>
        </a>
        <a href="/services#water" style="display:block;background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-decoration:none;color:inherit;">
          <div style="font-size:2.5rem;margin-bottom:16px;">💧</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Water Damage Restoration</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:16px;">24/7 emergency extraction, drying, and restoration. Fast response to minimize damage and prevent mold growth.</p>
          <span style="color:#1B7A3D;font-weight:600;font-size:.875rem;">Learn More →</span>
        </a>
        <a href="/services#mold" style="display:block;background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-decoration:none;color:inherit;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🔬</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Mold Inspection & Removal</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:16px;">Professional mold inspection, air sampling, and certified remediation to keep your home safe and healthy.</p>
          <span style="color:#1B7A3D;font-weight:600;font-size:.875rem;">Learn More →</span>
        </a>
        <a href="/services#fire" style="display:block;background:#fff;border:1px solid #E2E8F0;border-radius:16px;padding:32px;box-shadow:0 2px 12px rgba(0,0,0,.06);text-decoration:none;color:inherit;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🔥</div>
          <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.125rem;font-weight:700;color:#0F1B2D;margin-bottom:10px;">Fire & Smoke Damage</h3>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:16px;">Comprehensive cleanup and restoration after fire and smoke damage, including odor elimination and structural drying.</p>
          <span style="color:#1B7A3D;font-weight:600;font-size:.875rem;">Learn More →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why BamaClean -->
  <section style="padding:80px 24px;background:#F1F5F9;">
    <div style="max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:64px;align-items:center;">
      <div>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Why Choose Us</p>
        <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:#0F1B2D;margin-bottom:24px;">North Alabama's Cleaning Experts Since 1993</h2>
        <p style="color:#475569;font-size:1rem;line-height:1.7;margin-bottom:32px;">BamaClean has been serving Madison, Huntsville, Florence, and all of North Alabama for over 30 years. We use professional-grade equipment, eco-friendly solutions, and proven techniques to deliver results that last.</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:16px;">
          <li style="display:flex;align-items:center;gap:12px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:22px;height:22px;min-width:22px;background:#E8F5EC;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#1B7A3D;">✓</span>
            Licensed, bonded &amp; fully insured
          </li>
          <li style="display:flex;align-items:center;gap:12px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:22px;height:22px;min-width:22px;background:#E8F5EC;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#1B7A3D;">✓</span>
            Family-safe, eco-friendly cleaning solutions
          </li>
          <li style="display:flex;align-items:center;gap:12px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:22px;height:22px;min-width:22px;background:#E8F5EC;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#1B7A3D;">✓</span>
            IICRC-certified technicians
          </li>
          <li style="display:flex;align-items:center;gap:12px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:22px;height:22px;min-width:22px;background:#E8F5EC;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#1B7A3D;">✓</span>
            24/7 emergency water damage response
          </li>
          <li style="display:flex;align-items:center;gap:12px;font-size:.9375rem;color:#334155;font-weight:500;">
            <span style="width:22px;height:22px;min-width:22px;background:#E8F5EC;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#1B7A3D;">✓</span>
            100% satisfaction guarantee
          </li>
        </ul>
        <a href="/about" style="display:inline-block;margin-top:32px;background:#1B7A3D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:14px 32px;border-radius:100px;">About BamaClean</a>
      </div>
      <div style="background:#fff;border-radius:20px;padding:40px;box-shadow:0 4px 16px rgba(0,0,0,.1);">
        <h3 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:800;color:#0F1B2D;margin-bottom:24px;text-align:center;">What Our Customers Say</h3>
        <div style="margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid #E2E8F0;">
          <div style="color:#F59E0B;font-size:1rem;margin-bottom:8px;">★★★★★</div>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:10px;font-style:italic;">"BamaClean did an incredible job on our carpets after our dog got into a mess. They were professional, fast, and the results were amazing. Will definitely use again!"</p>
          <p style="font-size:.875rem;font-weight:600;color:#0F1B2D;">— Sarah M., Madison AL</p>
        </div>
        <div>
          <div style="color:#F59E0B;font-size:1rem;margin-bottom:8px;">★★★★★</div>
          <p style="font-size:.9375rem;color:#475569;line-height:1.6;margin-bottom:10px;font-style:italic;">"Called them for emergency water damage at 2am and they were at our house within the hour. Saved us from major mold problems. Cannot recommend them enough."</p>
          <p style="font-size:.875rem;font-weight:600;color:#0F1B2D;">— James T., Huntsville AL</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section style="padding:80px 24px;background:#fff;text-align:center;">
    <div style="max-width:1280px;margin:0 auto;">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:.8125rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#1B7A3D;margin-bottom:10px;">Where We Serve</p>
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:#0F1B2D;margin-bottom:40px;">Serving All of North Alabama</h2>
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:800px;margin:0 auto 40px;">
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Madison, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Huntsville, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Florence, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Muscle Shoals, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Decatur, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Athens, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Tuscumbia, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Sheffield, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Russellville, AL</span>
        <span style="background:#E8F5EC;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:600;font-size:.875rem;padding:8px 18px;border-radius:100px;">Killen, AL</span>
      </div>
      <a href="/locations" style="display:inline-block;background:#0F1B2D;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:14px 32px;border-radius:100px;">View All Service Areas</a>
    </div>
  </section>

  <!-- CTA Banner -->
  <section style="background:linear-gradient(135deg,#1B7A3D 0%,#145C2E 100%);color:#fff;padding:80px 24px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <h2 style="font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;margin-bottom:16px;">Ready for Cleaner, Fresher Spaces?</h2>
      <p style="font-size:1.125rem;color:rgba(255,255,255,.85);margin-bottom:40px;">Get a free quote today. Fast response, professional results, 100% satisfaction guaranteed.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/contact" style="background:#fff;color:#1B7A3D;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;padding:16px 36px;border-radius:100px;font-size:1rem;">Get a Free Quote</a>
        <a href="tel:+12563240492" style="background:transparent;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:16px 36px;border-radius:100px;border:2px solid rgba(255,255,255,.5);font-size:1rem;">Call (256) 324-0492</a>
      </div>
    </div>
  </section>

</Layout>
